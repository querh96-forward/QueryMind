# Copy to .env. Real credentials belong only in .env (ignored by Git and Docker).
# Chat model; legacy DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL are accepted as aliases.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
MOCK_LLM=false

# OpenAI-compatible embeddings, independent from the chat model.
# hash is an explicit offline test/baseline mode; there is no automatic fallback.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=10
RAG_TOP_K=5
RAG_CACHE_SECONDS=300

POSTGRES_PASSWORD=querymind
NORTHWIND_READER_PASSWORD=northwind_reader
DEFAULT_TOKEN_BUDGET=20000
MAX_AGENT_LOOPS=5
MAX_TOOL_CALLS=8
MAX_RUNTIME_SECONDS=90
# Two repair opportunities allow up to three failed SQL attempts.
MAX_SQL_REPAIRS=2
TAVILY_API_KEY=

# Example estimates only; set these to your provider's actual pricing.
INPUT_COST_PER_MILLION=0.8
OUTPUT_COST_PER_MILLION=2.0
EMBEDDING_COST_PER_MILLION=0.1
